---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

interface StatCard {
  value: string;
  count?: number;
  suffix?: string;
  title: string;
  body: string;
}

const stats: StatCard[] = [
  { value: '5–20%', title: 'HALEU Enrichment Range', body: 'The U-235 concentration band that separates high-assay fuel from the low-enriched uranium powering today’s reactors.' },
  { value: '0', count: 50, suffix: '%+', title: 'Of New SMR Designs Need HALEU', body: 'More than half of small modular reactor designs in development depend on fuel not yet produced at scale outside Russia and China.' },
  { value: '0', count: 50, suffix: 'bn+', title: 'Waste-to-Energy Market by 2032', body: 'Projected global sector revenue as ageing landfill capacity and rising power demand push waste toward the grid.' },
  { value: 'Ongoing', title: 'Fusion: Still Pre-Commercial', body: '2026 progress is real but incremental engineering and supply-chain work, not yet grid-scale power.' },
];

interface EnergySource {
  num: string;
  title: string;
  body: string;
  tag: string;
}

const sources: EnergySource[] = [
  {
    num: '01',
    title: 'Nuclear Fission',
    body: 'Today’s workhorse: splitting heavy atoms (mostly Uranium-235) to release heat that drives a turbine. It already supplies a meaningful share of the world’s low-carbon electricity and runs at very high uptime.',
    tag: 'Established',
  },
  {
    num: '02',
    title: 'SMRs, LEU & HALEU',
    body: 'Small modular reactors promise faster builds and lower upfront cost. Most rely on HALEU (5–20% U-235) rather than the LEU (under 5%) used in conventional plants a supply chain still being built out in the West.',
    tag: 'Scaling Up',
  },
  {
    num: '03',
    title: 'Nuclear Fusion',
    body: 'Fusing light atoms (deuterium and tritium, isotopes of Hydrogen) releases far more energy per gram than fission with none of the long-lived waste. Multiple approaches magnetic confinement, laser, field-reversed configuration are advancing, but commercial power remains years out.',
    tag: 'Emerging',
  },
  {
    num: '04',
    title: 'Waste-to-Energy',
    body: 'Converting municipal or industrial waste into electricity and heat through incineration, gasification, or anaerobic digestion. It solves two problems at once landfill pressure and baseload power and is scaling fastest where both are acute.',
    tag: 'Circular Economy',
  },
  {
    num: '05',
    title: 'Green & Blue Hydrogen',
    body: 'Hydrogen, the lightest element on the periodic table, can store and move energy generated elsewhere. "Green" hydrogen is split from water using renewable electricity; "blue" is produced from natural gas with the carbon captured.',
    tag: 'Storage & Fuel',
  },
  {
    num: '06',
    title: 'Enhanced Geothermal',
    body: 'New drilling techniques borrowed from oil and gas let developers reach useful heat almost anywhere, not just at tectonic hotspots turning geothermal from a niche resource into a potential always-on power source.',
    tag: 'Emerging',
  },
];

interface Element {
  symbol: string;
  number: string;
  name: string;
  role: string;
  accent: string;
}

const elements: Element[] = [
  { symbol: 'U', number: '92', name: 'Uranium', role: 'The primary fuel for fission today, enriched to different grades (LEU, HALEU) depending on the reactor.', accent: '#1d4e89' },
  { symbol: 'Th', number: '90', name: 'Thorium', role: 'A more abundant potential fission fuel with a different waste profile; molten-salt thorium reactors remain an active R&D track.', accent: '#123561' },
  { symbol: 'H', number: '1', name: 'Hydrogen', role: 'Fuel for fusion (as deuterium and tritium) and a storage medium for renewable electricity via green hydrogen.', accent: '#2f7d5e' },
  { symbol: 'Li', number: '3', name: 'Lithium', role: 'Not a fuel itself, but the battery chemistry that lets intermittent sources like solar, wind, and even excess reactor output be stored and dispatched.', accent: '#7a6a1d' },
];

const misconceptions = [
  { myth: '"Nuclear" Means One Thing', reality: 'Fission and fusion share a name but almost nothing else in timeline, technology, or investment profile. Treating them as interchangeable leads to poor planning.' },
  { myth: 'Fusion Is Just Around the Corner', reality: 'Independent 2026 assessments describe fusion progress as incremental and engineering-heavy real momentum, but not a near-term grid solution.' },
  { myth: 'Waste-to-Energy Is "Free" Power', reality: 'Feedstock logistics, emissions controls, and permitting all carry real cost and lead time. It’s a strong option, not a shortcut.' },
  { myth: 'HALEU Is Already Available', reality: 'Commercial-scale HALEU production currently sits mostly with Russia and China. Western supply is being built, but isn’t yet at scale.' },
  { myth: 'One Technology Will Win', reality: 'The businesses planning best aren’t betting on a single source they’re building strategies that flex as each technology matures on its own timeline.' },
];

const horizons = [
  { label: 'Now – 2030', title: 'Assess & Secure', items: ['Audit current energy exposure & cost risk', 'Evaluate on-site waste-to-energy where applicable', 'Track SMR & HALEU supply-chain announcements', 'Model long-term power purchase agreements'] },
  { label: '2030 – 2035', title: 'Pilot & Diversify', items: ['Engage early SMR & advanced-fission projects', 'Pilot green hydrogen for storage or heavy transport', 'Diversify sourcing for lithium, uranium & rare elements', 'Build fusion & geothermal into scenario planning'] },
  { label: '2035+', title: 'Scale & Optimise', items: ['Blend multiple non-carbon sources by use case', 'Formalise supply-chain resilience for critical elements', 'Reassess as fusion & EGS technologies mature', 'Embed energy strategy into core business planning'] },
];

const faqEntries = [
  {
    id: 'faq1',
    question: 'Is nuclear fission the same as nuclear fusion?',
    answer:
      'No. Fission splits heavy atoms like Uranium and is the technology behind every operating nuclear plant today. Fusion joins light atoms (isotopes of Hydrogen) and is still in development. They differ enormously in maturity, cost, and timeline treat them as two separate strategies, not one.',
  },
  {
    id: 'faq2',
    question: 'What’s the difference between LEU and HALEU, and why does it matter for my business?',
    answer:
      'LEU is enriched to under 5% U-235 and fuels today’s conventional reactors. HALEU is enriched to 5–20% and is required by most next-generation small modular reactor designs. If your business is evaluating SMR partnerships or power agreements, HALEU supply-chain maturity is a key risk factor to watch.',
  },
  {
    id: 'faq3',
    question: 'Can waste-to-energy work for a single facility, or only at utility scale?',
    answer:
      'Both. Utility-scale waste-to-energy plants serve municipal grids, but smaller anaerobic digestion or gasification systems can be sized for a single industrial site with high organic or process waste turning a disposal cost into a power source.',
  },
  {
    id: 'faq4',
    question: 'Should we be securing supply chains for critical elements like lithium and uranium now?',
    answer:
      'For energy-intensive or energy-adjacent businesses, yes it’s worth starting the conversation. Enrichment capacity, battery-grade lithium, and rare-earth supply are all tightening as demand from fission, storage, and renewables grows in parallel. Early diversification reduces exposure later.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Beyond Oil & Gas: Nuclear, Waste-to-Energy and the Next Energy Frontier',
  description:
    'A business leader’s guide to non-carbon energy sources nuclear fission, fusion, LEU and HALEU, waste-to-energy, hydrogen, geothermal, and the elements behind them.',
  mainEntityOfPage: 'https://thedistinct5ltd.com/energy-beyond-carbon.html',
  author: { '@type': 'Organization', name: 'THE DISTINCT 5 Ltd', url: 'https://thedistinct5ltd.com/' },
  publisher: { '@type': 'Organization', name: 'THE DISTINCT 5 Ltd', url: 'https://thedistinct5ltd.com/' },
  datePublished: '2026-09-09',
  dateModified: '2026-09-09',
  inLanguage: 'en-GB',
});
---

<BaseLayout
  title="Beyond Oil & Gas: The Next Energy Frontier | THE DISTINCT 5 Ltd"
  description="A business leader's guide to non-carbon energy sources nuclear fission, fusion, LEU and HALEU, waste-to-energy, hydrogen, geothermal, and the elements behind them."
  path="/energy-beyond-carbon.html"
  jsonLd={jsonLd}
  ogType="article"
  activeNav="energy"
  footerVariant="insight"
  guideLinks={[
    { href: '#why-it-matters', label: 'Why It Matters' },
    { href: '#sources', label: 'The Sources' },
    { href: '#elements', label: 'Key Elements' },
    { href: '#roadmap', label: 'Roadmap' },
    { href: '#faq', label: 'FAQ' },
  ]}
>
  <section class="hero" aria-label="Introduction">
    <img
      class="hero-bg"
      src="/images/energy-beyond-carbon-hero.jpeg"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />
    <div class="hero-inner">
      <span class="eyebrow">Advisory Insight</span>
      <h1>Beyond Oil &amp; Gas: The Next Energy Frontier</h1>
      <p class="lede">A business leader’s guide to the non-carbon energy sources reshaping supply chains, procurement, and long-term strategy from nuclear fission and fusion to waste-to-energy and beyond.</p>
      <div class="hero-cta">
        <a href="#intro" class="btn btn-primary">Explore the Guide &darr;</a>
        <a href="/index.html#contact" class="btn btn-ghost">Talk to an Advisor</a>
      </div>
      <div class="hero-stats">
        <div class="hs-item">
          <span class="hs-label">Read time</span>
          <span class="hs-value">10 minutes</span>
        </div>
        <div class="hs-item">
          <span class="hs-label">Covers</span>
          <span class="hs-value">Fission &amp; fusion &middot; LEU/HALEU &middot; waste-to-energy &middot; roadmap</span>
        </div>
        <div class="hs-item">
          <span class="hs-label">Written for</span>
          <span class="hs-value">Leaders assessing energy risk &amp; supply-chain exposure</span>
        </div>
      </div>
    </div>
  </section>

  <section class="intro" id="intro" aria-label="Introduction">
    <div class="narrow reveal">
      <p><span class="lead-mark">Energy strategy has become a board-level question.</span> Whatever your sector, the cost, reliability, and carbon intensity of the power behind your operations now shapes procurement decisions, investor conversations, and long-term risk planning and oil and gas are no longer the only default.</p>
      <p>This isn’t a call to bet everything on one technology. It’s a map of the non-carbon sources maturing at very different speeds, and what that means for how you plan.</p>
    </div>
  </section>

  <section class="stat-strip" id="why-it-matters" aria-label="Why this matters">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Why It Matters</span>
        <h2>The numbers behind the <span class="grad-text">shift</span></h2>
        <p>A handful of figures that explain why this is moving from a sustainability topic to a supply-chain one.</p>
      </div>
      <div class="strip-row stagger">
        {stats.map((s) => (
          <div class="strip-item reveal">
            {s.count !== undefined ? (
              <div class="strip-num" data-count={s.count} data-suffix={s.suffix}>0</div>
            ) : (
              <div class="strip-num">{s.value}</div>
            )}
            <h4>{s.title}</h4>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="timeline-sources" id="sources" aria-label="Non-carbon energy sources">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">The Sources</span>
        <h2>Six non-carbon paths, <span class="grad-text">six different timelines</span></h2>
        <p>From technology already on the grid to approaches still in the lab.</p>
      </div>
      <div class="timeline">
        {sources.map((s, i) => (
          <div class={i % 2 === 1 ? 'tl-row tl-alt reveal' : 'tl-row reveal'}>
            <div class="tl-card">
              <span class="tag">{s.tag}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
            <div class="tl-marker" aria-hidden="true">{s.num}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="elements" id="elements" aria-label="Elements behind the technology">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">The Periodic Table</span>
        <h2>The elements doing the <span class="grad-text">heavy lifting</span></h2>
        <p>Every one of these technologies traces back to a handful of elements worth knowing by name.</p>
      </div>
      <div class="element-grid stagger">
        {elements.map((el) => (
          <div class="element-tile reveal" style={`--tile-accent: ${el.accent}`}>
            <span class="tile-number">{el.number}</span>
            <span class="tile-symbol">{el.symbol}</span>
            <h4>{el.name}</h4>
            <p>{el.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="myths" aria-label="Common misconceptions">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Watch Out</span>
        <h2>Common misconceptions to <span class="grad-text">avoid</span></h2>
        <p>The assumptions we see trip up otherwise sound energy planning.</p>
      </div>
      <div class="myth-list stagger">
        {misconceptions.map((m) => (
          <div class="myth-row reveal">
            <div class="myth-col myth-col-myth">
              <span class="myth-tag">Myth</span>
              <h4>{m.myth}</h4>
            </div>
            <div class="myth-col myth-col-reality">
              <span class="myth-tag myth-tag-reality">Reality</span>
              <p>{m.reality}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bigquote" aria-label="Key insight">
    <div class="reveal">
      <div class="qm" aria-hidden="true">&ldquo;</div>
      <blockquote>The businesses that get ahead aren’t betting on a single fuel they’re building energy strategies that can flex as fission, fusion, and waste-to-energy each mature on their own timeline.</blockquote>
    </div>
  </section>

  <section class="roadmap-timeline" id="roadmap" aria-label="Business roadmap">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">The Roadmap</span>
        <h2>What this means for <span class="grad-text">your business</span></h2>
        <p>A realistic horizon for planning around non-carbon energy, whatever your sector.</p>
      </div>
      <div class="rt-track stagger">
        {horizons.map((h, i) => (
          <div class="rt-step reveal">
            <div class="rt-dot">{i + 1}</div>
            <div class="rt-label">{h.label}</div>
            <h4>{h.title}</h4>
            <ul>{h.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="faq" id="faq" aria-label="Frequently asked questions">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Questions? Answers.</span>
        <h2>Non-carbon energy <span class="grad-text">questions</span></h2>
        <p>What business leaders ask us most when this topic reaches their desk.</p>
      </div>
      <div class="faq-list reveal">
        {faqEntries.map((entry) => (
          <div class="faq-item">
            <button class="faq-q" id={`${entry.id}q`} aria-expanded="false" aria-controls={`${entry.id}a`}>
              {entry.question}
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-a" id={`${entry.id}a`} role="region" aria-labelledby={`${entry.id}q`}>
              <div class="faq-a-inner" set:html={entry.answer} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Plan your energy strategy with confidence"
    body="THE DISTINCT 5 helps businesses assess energy risk and opportunity across nuclear, waste-to-energy, and emerging sources. Book a complimentary strategy session."
    ctaLabel="Book Strategy Session"
    ctaHref="/index.html#contact"
  />

</BaseLayout>


<style>
  /* ============ HERO — single centered card, inline stat row ============ */
  .hero { position: relative; padding: 96px 24px 64px; border-top: none; overflow: hidden; display: flex; justify-content: center; }
  .hero-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    filter: blur(2px); transform: scale(1.12);
    z-index: 0; pointer-events: none;
  }
  .hero::after {
    content: ''; position: absolute; inset: 0;
    background: var(--white); opacity: 0.72;
    z-index: 0; pointer-events: none;
  }
  .hero-inner {
    position: relative; z-index: 1;
    max-width: 860px; width: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 12px 40px rgba(13, 20, 38, 0.12);
    padding: 52px 56px 40px;
    animation: hero-drop-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.15s;
  }
  @keyframes hero-drop-in {
    from { opacity: 0; transform: translateY(-40px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-inner { animation: none; }
  }
  .hero-inner .eyebrow { margin-bottom: 20px; }
  .hero h1 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(28px, 3.8vw, 44px); line-height: 1.14;
    letter-spacing: -0.6px; margin-bottom: 16px; color: var(--navy);
    max-width: 700px;
  }
  .hero .lede { font-size: 16px; color: var(--ink-soft); max-width: 640px; margin-bottom: 26px; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }
  .hero-stats { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid var(--line); padding-top: 24px; }
  .hs-item { padding-right: 30px; margin-right: 30px; border-right: 1px solid var(--line); max-width: 260px; }
  .hs-item:last-child { border-right: none; margin-right: 0; padding-right: 0; }
  .hs-label {
    display: block; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--steel); margin-bottom: 6px;
  }
  .hs-value { display: block; font-family: var(--font-head); font-size: 13.5px; color: var(--navy); font-weight: 500; }

  /* ============ INTRO ============ */
  .intro { background: var(--paper); }
  .intro p { font-size: 17px; color: var(--ink-soft); }
  .intro p + p { margin-top: 18px; }
  .intro .lead-mark { font-family: var(--font-display); font-weight: 800; color: var(--navy); font-size: 18px; }

  /* ============ WHY IT MATTERS — dark stat strip (fixed, theme-independent) ============ */
  .stat-strip { background: #0a1d38; }
  .stat-strip .section-head .eyebrow { color: #9fb8d9; background: none; }
  .stat-strip .section-head .eyebrow::before { background: #9fb8d9; }
  .stat-strip .section-head h2 { color: #fff; }
  .stat-strip .section-head .grad-text { color: #7eb3f0; }
  .stat-strip .section-head p { color: rgba(255, 255, 255, 0.68); }
  .strip-row { display: flex; flex-wrap: wrap; }
  .strip-item {
    flex: 1 1 220px; padding: 0 28px 0 0; margin-right: 28px; margin-bottom: 24px;
    border-right: 1px solid rgba(255, 255, 255, 0.14);
  }
  .strip-item:last-child { border-right: none; margin-right: 0; padding-right: 0; }
  .strip-num { font-family: var(--font-display); font-weight: 800; font-size: 34px; line-height: 1; color: #fff; }
  .strip-item h4 { font-family: var(--font-head); font-weight: 700; font-size: 14.5px; margin: 12px 0 6px; color: #fff; }
  .strip-item p { font-size: 12.5px; color: rgba(255, 255, 255, 0.65); }

  /* ============ SOURCES — alternating vertical timeline ============ */
  .timeline-sources { background: var(--white); }
  .timeline { position: relative; max-width: 900px; margin: 0 auto; }
  .timeline::before {
    content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px;
    background: var(--line); transform: translateX(-1px);
  }
  .tl-row {
    position: relative; display: flex; justify-content: flex-end;
    padding-right: calc(50% + 30px); margin-bottom: 28px;
  }
  .tl-alt { justify-content: flex-start; padding-right: 0; padding-left: calc(50% + 30px); }
  .tl-card {
    padding: 24px 26px; background: var(--paper); border: 1px solid var(--line);
    max-width: 380px; width: 100%;
  }
  .tl-marker {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 44px; height: 44px; border-radius: 50%; background: var(--navy); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 13px; font-weight: 600; z-index: 1;
  }
  .tl-card h3 { font-family: var(--font-head); font-weight: 700; font-size: 17px; margin-bottom: 8px; color: var(--navy); }
  .tl-card p { color: var(--ink-soft); font-size: 13.5px; margin-bottom: 14px; }
  .tag {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 1.2px; text-transform: uppercase;
    color: var(--steel);
  }

  /* ============ ELEMENTS — periodic-table tiles ============ */
  .elements { background: var(--paper); }
  .element-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .element-tile {
    position: relative; background: var(--white); border: 1px solid var(--line);
    border-top: 3px solid var(--tile-accent); padding: 22px 20px 20px; aspect-ratio: 1 / 1;
    display: flex; flex-direction: column;
  }
  .tile-number {
    position: absolute; top: 10px; left: 12px;
    font-family: var(--font-mono); font-size: 11px; color: var(--steel);
  }
  .tile-symbol {
    font-family: var(--font-display); font-weight: 800; font-size: 34px; color: var(--navy);
    margin-top: 14px; margin-bottom: 8px;
  }
  .element-tile h4 { font-family: var(--font-head); font-weight: 700; font-size: 14px; margin-bottom: 6px; color: var(--navy); }
  .element-tile p { font-size: 11.5px; color: var(--ink-soft); line-height: 1.4; }

  /* ============ MISCONCEPTIONS — myth / reality split rows ============ */
  .myths { background: var(--white); }
  .myth-list { max-width: 980px; margin: 0 auto; border-top: 1px solid var(--line); }
  .myth-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
    padding: 22px 0; border-bottom: 1px solid var(--line);
  }
  .myth-col { display: flex; flex-direction: column; gap: 8px; }
  .myth-tag {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--ink-soft); width: fit-content;
  }
  .myth-tag-reality { color: var(--steel); }
  .myth-col-myth h4 {
    font-family: var(--font-head); font-weight: 600; font-size: 15px; color: var(--ink-soft);
    text-decoration: line-through; text-decoration-color: var(--line-strong); text-decoration-thickness: 1px;
  }
  .myth-col-reality p { font-size: 13.5px; color: var(--ink); }

  /* ============ BIG QUOTE — centered ============ */
  /* Fixed dark band regardless of theme (like the footer/CTA band) —
     --navy flips to a light colour in dark mode, which would leave this
     white text unreadable against it if left theme-aware. */
  .bigquote { background: #0a1d38; color: #fff; text-align: center; display: flex; justify-content: center; }
  .bigquote > div { max-width: 780px; }
  .bigquote .qm { font-family: var(--font-display); font-weight: 800; font-size: 60px; line-height: 0.6; color: #eaf0f7; opacity: 0.5; }
  .bigquote blockquote {
    margin: 16px auto 0;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(20px, 2.8vw, 30px); line-height: 1.4; letter-spacing: -0.3px;
  }

  /* ============ ROADMAP — connected horizontal timeline ============ */
  .roadmap-timeline { background: var(--paper); }
  .rt-track { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; position: relative; }
  .rt-track::before {
    content: ''; position: absolute; top: 15px; left: 8%; right: 8%; height: 2px; background: var(--line);
  }
  .rt-step { position: relative; }
  .rt-dot {

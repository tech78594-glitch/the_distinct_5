---
---

<section class="hero" aria-label="Introduction">
  <div class="hero-bg">
    <img
      src="/images/img-about-team.png"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="1600"
      height="1000"
    />
    <div class="hero-bg-overlay"></div>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Business Consultancy &amp; Advisory</span>
      <h1>Clarity. Strategy.<br />Measurable Growth.</h1>
      <p>
        THE DISTINCT 5 Ltd partners with ambitious businesses and individuals to solve problems, sharpen
        strategy, and unlock sustainable performance across the boardroom, the balance sheet,
        and the build.
      </p>
      <div class="hero-cta">
        <a href="#services" class="btn btn-primary">Explore Services &rarr;</a>
        <a href="#contact" class="btn btn-ghost">Schedule Consultation</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 82px;
    border-top: none;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(25%) contrast(1.05) brightness(0.55);
  }
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(8, 15, 28, 0.92) 0%, rgba(8, 15, 28, 0.78) 42%, rgba(8, 15, 28, 0.35) 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  .hero-copy {
    padding: 96px 48px;
    display: flex; flex-direction: column; justify-content: center;
    min-height: 520px;
  }
  .hero-copy .eyebrow { margin-bottom: 22px; color: #cfd8e8; }
  .hero h1 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(32px, 4.4vw, 52px); line-height: 1.1;
    letter-spacing: -0.6px; margin-bottom: 22px; color: #fff;
  }
  .hero p { font-size: 16.5px; color: rgba(255, 255, 255, 0.82); max-width: 480px; margin-bottom: 30px; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-cta .btn-primary { background: #fff; color: #0a1d38; }
  .hero-cta .btn-primary:hover { background: #e7ecf2; }
  .hero-cta .btn-ghost { color: #fff; border: 1px solid rgba(255, 255, 255, 0.55); }
  .hero-cta .btn-ghost:hover { border-color: #fff; background: rgba(255, 255, 255, 0.1); }

  @media (max-width: 680px) {
    .hero { padding-top: 0; }
    .hero-copy { padding: 64px 24px; min-height: 440px; }
  }
</style>

---
import { newsItems, HOME_NEWS_LIMIT, type NewsItem } from '../data/news';

export interface Props {
  /** Show every article (used on /news.html) instead of the homepage preview. */
  showAll?: boolean;
}
const { showAll = false } = Astro.props;

const items: NewsItem[] = showAll ? newsItems : newsItems.slice(0, HOME_NEWS_LIMIT);
const hasMore = !showAll && newsItems.length > HOME_NEWS_LIMIT;
---

<section class="insights" id="news" aria-label="News">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">News &amp; Insights</span>
      <h2>Thinking that keeps you ahead</h2>
      <p>Latest news and practical guidance from our advisory team.</p>
    </div>
    <div id="news-container">
      <div class="skeleton-state insight-row" style="margin-bottom: 0;">
        <div class="ir-tag skeleton skeleton-text" style="width: 100px; height: 16px; margin: 0;"></div>
        <div class="ir-main">
          <div class="skeleton skeleton-text title" style="width: 70%;"></div>
          <div class="skeleton skeleton-text"></div>
          <div class="skeleton skeleton-text"></div>
          <div class="skeleton skeleton-text short"></div>
        </div>
        <div class="ir-meta">
          <div class="skeleton skeleton-text" style="width: 80px;"></div>
          <div class="skeleton skeleton-text" style="width: 80px;"></div>
          <div class="skeleton skeleton-text" style="width: 80px;"></div>
        </div>
        <div class="ir-arrow" aria-hidden="true" style="opacity: 0.2;">&rarr;</div>
      </div>

      <div class="real-state" style="display: none; width: 100%;">
        {items.map((item) => (
          <a href={item.href} class="insight-row reveal">
            <div class="ir-tag">{item.tag}</div>
            <div class="ir-main">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
            <div class="ir-meta">
              {item.meta.map((m) => <span>{m}</span>)}
            </div>
            <div class="ir-arrow" aria-hidden="true">&rarr;</div>
          </a>
        ))}

        {(hasMore || !showAll) && (
          <div class="insights-more reveal">
            <a href="/news.html" class="btn btn-ghost">View All News &rarr;</a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const container = document.getElementById('news-container');
      if (container) {
        const skel = container.querySelector('.skeleton-state') as HTMLElement;
        const real = container.querySelector('.real-state') as HTMLElement;
        if (skel) skel.style.display = 'none';
        if (real) real.style.display = 'contents';
      }
    }, 800);
  });
</script>

<style>
  .insights { background: var(--paper); }
  .insight-row {
    display: grid; grid-template-columns: 140px 1.6fr 1fr 40px; gap: 30px; align-items: center;
    padding: 34px; background: var(--white); border: 1px solid var(--line);
    transition: border-color 0.2s var(--ease);
  }
  .insight-row + .insight-row { margin-top: 16px; }
  .insight-row:hover { border-color: var(--navy); }
  .ir-tag {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--steel);
  }
  .ir-main h3 { font-family: var(--font-head); font-weight: 700; font-size: 19px; margin-bottom: 8px; color: var(--navy); }
  .ir-main p { color: var(--ink-soft); font-size: 14px; }
  .ir-meta { display: grid; gap: 8px; font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-soft); }
  .ir-arrow { font-size: 22px; color: var(--navy); justify-self: end; }

  .insights-more { display: flex; justify-content: center; margin-top: 32px; }

  @media (max-width: 980px) {
    .insight-row { grid-template-columns: 1fr; gap: 16px; }
    .ir-arrow { display: none; }
  }
</style>

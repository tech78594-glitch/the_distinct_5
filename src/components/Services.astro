---

<section class="services" id="services" aria-label="Our services">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our Services</span>
      <h2>Engineered around your business</h2>
      <p>Six connected capabilities, one advisory team tailored consultancy and ongoing support, each built for measurable impact.</p>
    </div>

    <div class="services-list" id="services-page-container">
      <div class="skeleton-state" style="display: contents;">
        {[1, 2, 3].map((item, i) => (
          <article class="service-full-section" style={i % 2 === 1 ? 'flex-direction: row-reverse;' : ''}>
            <div class="sfs-media skeleton"></div>
            <div class="sfs-body">
              <div class="skeleton skeleton-text" style="width: 120px; height: 16px; margin-bottom: 16px;"></div>
              <div class="skeleton skeleton-text title" style="width: 65%; height: 32px; margin-bottom: 16px;"></div>
              <div class="skeleton skeleton-text" style="max-width: 600px;"></div>
              <div class="skeleton skeleton-text" style="max-width: 600px;"></div>
              <div class="skeleton skeleton-text short" style="margin-bottom: 24px;"></div>
              <ul class="feat" style="display: grid; gap: 12px; margin-top: 10px;">
                <li class="skeleton skeleton-text" style="width: 90%;"></li>
                <li class="skeleton skeleton-text" style="width: 80%;"></li>
                <li class="skeleton skeleton-text" style="width: 85%;"></li>
              </ul>
            </div>
          </article>
        ))}
      </div>

      <div class="real-state" style="display: none;">
        {[...featureServices, ...rowServices.map(s => ({...s, tag: 'Core Service', image: ''}))].map((service, index) => (
          <article class="service-full-section reveal">
            {service.image && (
              <div class="sfs-media">
                <img 
                  src={service.image} 
                  alt={service.title} 
                  loading="lazy" 
                  decoding="async" 
                  width="800" 
                  height="450" 
                />
              </div>
            )}
            <div class="sfs-body">
              <span class="sfs-num">
                <span class="sfs-icon" set:html={service.icon} />
                {service.tag || 'Core Service'}
              </span>
              <h2>{service.title}</h2>
              <p>{service.description}</p>
              <ul class="feat">
                {service.features.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const container = document.getElementById('services-page-container');
      if (container) {
        const skel = container.querySelector('.skeleton-state') as HTMLElement;
        const real = container.querySelector('.real-state') as HTMLElement;
        if (skel) skel.style.display = 'none';
        if (real) real.style.display = 'contents';
      }
    }, 800);
  });
</script>

<style>
  .services { background: var(--paper); padding-top: 60px; }
  .services-list { display: flex; flex-direction: column; gap: 40px; margin-top: 40px; }
  .service-full-section { 
    display: flex; 
    flex-direction: column; 
    background: var(--white); 
    border: 1px solid var(--line); 
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 980px) {
    .service-full-section { flex-direction: row; align-items: stretch; }
    .service-full-section:nth-child(even) { flex-direction: row-reverse; }
    .sfs-media { width: 45%; border-bottom: none; border-right: 1px solid var(--line); }
    .service-full-section:nth-child(even) .sfs-media { border-right: none; border-left: 1px solid var(--line); }
    .sfs-body { width: 55%; padding: 60px; }
  }
  
  .sfs-media { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--line); }
  .sfs-media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(15%) contrast(1.05); }
  .sfs-body { padding: 40px 32px; display: flex; flex-direction: column; justify-content: center; }
  .sfs-num {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--steel); display: flex; align-items: center; margin-bottom: 16px; gap: 8px;
  }
  .sfs-icon { display: flex; align-items: center; justify-content: center; color: var(--steel); }
  .sfs-body h2 { font-family: var(--font-head); font-weight: 700; font-size: 28px; margin-bottom: 16px; color: var(--navy); }
  .sfs-body p { color: var(--ink-soft); font-size: 16px; margin-bottom: 24px; max-width: 600px; }
</style>

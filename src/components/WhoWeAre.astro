---
interface Pillar {
  n: string;
  title: string;
  body: string;
}

const whoPillars: Pillar[] = [
  { n: '01', title: 'Experienced from day one', body: 'Every engagement is led by experienced specialists, not handed off to juniors once the contract is signed.' },
  { n: '02', title: 'Built for every stage', body: 'Frameworks that flex for startups, scale-ups and established firms alike never a one-size template.' },
  { n: '03', title: 'Embedded, not external', body: "We work inside your team's rhythm and decisions, not at arm's length from them." },
];

const visionPillars: Pillar[] = [
  { n: '01', title: 'Clear targets', body: 'Every strategy begins with the metric it’s meant to move.' },
  { n: '02', title: 'Systems that scale', body: 'Frameworks built to outlast the engagement, not just survive it.' },
  { n: '03', title: 'Growth that compounds', body: 'Outcomes tracked and built on, quarter over quarter.' },
];

const missionPillars: Pillar[] = [
  { n: '01', title: 'Plain-English diagnosis', body: 'No jargon standing between you and the real problem.' },
  { n: '02', title: 'One clear plan', body: 'A single, prioritised path forward, not a menu of competing options.' },
  { n: '03', title: 'Visible accountability', body: 'You always know what’s done, what’s next, and why.' },
];
---

<section class="wwa-intro" id="who-we-are" aria-label="Who we are">
  <div class="wrap">
    <div class="wwa-intro-grid">
      <div class="wwa-intro-copy reveal">
        <span class="eyebrow">Who We Are</span>
        <h1>A experienced advisory team, built around your business</h1>
        <p class="lead">
          THE DISTINCT 5 Ltd is a business consultancy and advisory partner working across strategy
          &amp; operations, financial advisory &amp; marketing, leadership &amp; fractional executive
          support, branding &amp; business development, and digital product, data &amp; AI delivery
          brought together under one team instead of scattered across separate specialists.
        </p>
        <p class="lead">
          We work alongside founders, leadership teams and individuals who need more than a slide
          deck: hands-on delivery, honest counsel, and a plan built for the stage their business is
          actually at.
        </p>
        <dl class="wwa-fact">
          <div>
            <dt>Engagement model</dt>
            <dd>Performance-led, outcome-based advisory</dd>
          </div>
          <div>
            <dt>Coverage</dt>
            <dd>Strategy &middot; Finance &middot; Marketing &middot; Leadership &middot; Digital &amp; AI</dd>
          </div>
        </dl>
      </div>
      <div class="wwa-intro-photo reveal">
        <img
          src="/images/Team_collaborating_on_office_wall_202609071521.jpeg"
          alt="Our advisory team collaborating"
          loading="eager"
          decoding="async"
          width="700"
          height="800"
        />
      </div>
    </div>

    <div class="wwa-pillars stagger">
      {whoPillars.map((p) => (
        <div class="wwa-pillar reveal">
          <div class="wwa-pillar-n">{p.n}</div>
          <h4>{p.title}</h4>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="wwa-vision" id="vision" aria-label="Our vision">
  <img
    class="wwa-vision-bg"
    src="/images/Glass_vessels_showing_revenue_gr…_202609071459.jpeg"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="wwa-vision-overlay" aria-hidden="true"></div>
  <div class="wrap">
    <div class="wwa-vision-card reveal">
      <span class="eyebrow">Vision</span>
      <h2>Strategy that compounds into measurable growth</h2>
      <p class="lead">
        We see a future where every strategic decision a business makes ties back to a number it can
        actually track not a slide that gets shelved after the workshop. Our vision is to be the
        advisory partner that turns ambition into a plan with a scoreboard: clear targets, systems
        that scale past the first win, and growth that compounds instead of resetting every quarter.
      </p>
      <ul class="feat wwa-vision-feat">
        {visionPillars.map((p) => (
          <li><strong>{p.title}.</strong> {p.body}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="wwa-mission" id="mission" aria-label="Our mission">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Mission</span>
      <h2>Bringing clarity to every decision we touch</h2>
      <p>
        Our mission is simple: cut through the noise. Businesses rarely stall from a lack of ideas
        they stall under too many of them, delivered without a clear view of what matters first. We
        exist to bring that clarity.
      </p>
    </div>
    <div class="wwa-mission-grid stagger">
      {missionPillars.map((p) => (
        <div class="wwa-mission-item reveal">
          <div class="wwa-mission-n">{p.n}</div>
          <h4>{p.title}</h4>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ============ WHO WE ARE — intro split + pillars ============ */
  .wwa-intro { background: var(--white); padding-top: 60px; }
  .wwa-intro-grid {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center;
    margin-bottom: 56px;
  }
  .wwa-intro-copy h1 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(28px, 3.6vw, 42px); line-height: 1.16; letter-spacing: -0.4px;
    margin: 18px 0 20px; color: var(--navy);
  }
  .wwa-intro-copy .lead { color: var(--ink-soft); font-size: 16px; line-height: 1.65; margin-bottom: 16px; max-width: 560px; }
  .wwa-fact { margin-top: 8px; padding-top: 20px; border-top: 1px solid var(--line); max-width: 560px; }
  .wwa-fact dt {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--steel); margin-bottom: 6px;
  }
  .wwa-fact dd { font-family: var(--font-head); font-size: 14px; color: var(--navy); font-weight: 500; }
  .wwa-intro-photo { border: 1px solid var(--line); overflow: hidden; aspect-ratio: 7 / 8; }
  .wwa-intro-photo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(10%) contrast(1.03); }

  .wwa-pillars { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); }
  .wwa-pillar { padding: 32px; border-right: 1px solid var(--line); }
  .wwa-pillar:last-child { border-right: none; }
  .wwa-pillar-n { font-family: var(--font-mono); font-size: 12px; color: var(--steel); margin-bottom: 14px; }
  .wwa-pillar h4 { font-family: var(--font-head); font-weight: 700; font-size: 16px; margin-bottom: 8px; color: var(--navy); }
  .wwa-pillar p { color: var(--ink-soft); font-size: 13.5px; }

  /* ============ VISION — blurred background hero card ============ */
  .wwa-vision { position: relative; padding: 88px 24px; overflow: hidden; display: flex; justify-content: center; }
  .wwa-vision-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    filter: blur(3px); transform: scale(1.12);
    z-index: 0; pointer-events: none;
  }
  .wwa-vision-overlay {
    position: absolute; inset: 0; background: var(--white); opacity: 0.78;
    z-index: 0; pointer-events: none;
  }
  .wwa-vision-card {
    position: relative; z-index: 1; max-width: 780px; margin: 0 auto;
    background: var(--white); border: 1px solid var(--line);
    box-shadow: 0 12px 40px rgba(13, 20, 38, 0.12);
    padding: 52px 56px;
  }
  .wwa-vision-card h2 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(26px, 3.2vw, 36px); line-height: 1.18; letter-spacing: -0.4px;
    margin: 18px 0 18px; color: var(--navy);
  }
  .wwa-vision-card .lead { color: var(--ink-soft); font-size: 16px; line-height: 1.65; margin-bottom: 24px; }
  .wwa-vision-feat { border-top: 1px solid var(--line); padding-top: 20px; display: grid; gap: 12px; }
  .wwa-vision-feat li { font-size: 14px; color: var(--ink); }
  .wwa-vision-feat li strong { color: var(--navy); }

  /* ============ MISSION — fixed dark band (theme-independent, matches the
     site's other dark bands: footer, CTA band, pull-quotes) ============ */
  .wwa-mission { background: #0a1d38; }
  .wwa-mission .section-head .eyebrow { color: #9fb8d9; background: none; }
  .wwa-mission .section-head .eyebrow::before { background: #9fb8d9; }
  .wwa-mission .section-head h2 { color: #fff; }
  .wwa-mission .section-head p { color: rgba(255, 255, 255, 0.72); max-width: 640px; }
  .wwa-mission-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 16px; }
  .wwa-mission-item { border-top: 2px solid rgba(255, 255, 255, 0.18); padding-top: 18px; }
  .wwa-mission-n { font-family: var(--font-mono); font-size: 12px; color: #9fb8d9; margin-bottom: 12px; }
  .wwa-mission-item h4 { font-family: var(--font-head); font-weight: 700; font-size: 15px; margin-bottom: 8px; color: #fff; }
  .wwa-mission-item p { font-size: 13px; color: rgba(255, 255, 255, 0.68); }

  @media (max-width: 980px) {
    .wwa-intro-grid { grid-template-columns: 1fr; gap: 32px; }
    .wwa-intro-photo { aspect-ratio: 16 / 10; order: -1; }
    .wwa-pillars { grid-template-columns: 1fr; }
    .wwa-pillar { border-right: none; border-bottom: 1px solid var(--line); }
    .wwa-pillar:last-child { border-bottom: none; }
    .wwa-vision-card { padding: 36px 28px; }
    .wwa-mission-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

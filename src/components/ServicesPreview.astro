---
interface FeatureService {
  num: string;
  tag: string;
  title: string;
  description: string;
  features: string[];
  image: string;
  icon: string;
}

const featureServices: FeatureService[] = [
  {
    num: '01',
    tag: 'Strategy & Operations',
    title: 'Business Strategy & Operations Optimisation',
    description:
      "Growth planning and operational excellence, run from the same plan — so the strategy you set is the strategy your business can actually deliver.",
    features: [
      'Growth & market-entry roadmaps, competitive positioning',
      'Process mapping, efficiency programmes & waste reduction',
      'Quarterly execution planning & performance tracking',
    ],
    image: '/images/img-strategy-ops.jpg',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>',
  },
  {
    num: '02',
    tag: 'Digital, Data & AI',
    title: 'Digital Product, Data & Artificial Intelligence Development',
    description:
      'Product, data and AI capability built by people who understand the business behind it — turned into tools that save time and create real advantage.',
    features: [
      'Digital product design, build & delivery',
      'Data platforms, pipelines & reporting (BI/analytics)',
      'Applied AI — automation, insight & decision support',
    ],
    image: '/images/img-digital-ai.jpg',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>',
  },
];
---

<section class="services" id="services" aria-label="Our services">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our Services</span>
      <h2>Engineered around your business</h2>
      <p>Our core capabilities build measurable impact.</p>
      <a href="/services.html" class="btn btn-primary" style="margin-top: 16px; display: inline-block;">View All Services &rarr;</a>
    </div>

    <div class="feature-grid stagger" id="services-preview-container">
      <div class="skeleton-state" style="display: contents;">
        {[1, 2].map(() => (
          <article class="service-feature">
            <div class="sf-media skeleton"></div>
            <div class="sf-body">
              <div class="skeleton skeleton-text" style="width: 100px; height: 16px; margin-bottom: 12px;"></div>
              <div class="skeleton skeleton-text title" style="width: 80%;"></div>
              <div class="skeleton skeleton-text"></div>
              <div class="skeleton skeleton-text"></div>
              <div class="skeleton skeleton-text short"></div>
              <ul class="feat" style="margin-top: 16px; display: grid; gap: 8px;">
                <li class="skeleton skeleton-text" style="width: 90%;"></li>
                <li class="skeleton skeleton-text" style="width: 70%;"></li>
                <li class="skeleton skeleton-text" style="width: 85%;"></li>
              </ul>
            </div>
          </article>
        ))}
      </div>

      <div class="real-state" style="display: none;">
        {featureServices.map((service) => (
          <article class="service-feature reveal">
            <div class="sf-media">
              <img 
                src={service.image} 
                alt={service.title} 
                loading="lazy" 
                decoding="async" 
                width="600" 
                height="338" 
              />
            </div>
            <div class="sf-body">
              <span class="sf-num">
                <span class="sf-icon" set:html={service.icon} />
                {service.num} &middot; {service.tag}
              </span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <ul class="feat">
                {service.features.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const container = document.getElementById('services-preview-container');
      if (container) {
        const skel = container.querySelector('.skeleton-state') as HTMLElement;
        const real = container.querySelector('.real-state') as HTMLElement;
        if (skel) skel.style.display = 'none';
        if (real) real.style.display = 'contents';
      }
    }, 800);
  });
</script>

<style>
  .services { background: var(--white); }
  .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 0; border: 1px solid var(--line); }
  .service-feature { display: flex; flex-direction: column; border-right: 1px solid var(--line); }
  .service-feature:last-child { border-right: none; }
  .sf-media { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--line); }
  .sf-media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(15%) contrast(1.05); }
  .sf-body { padding: 32px; flex: 1; display: flex; flex-direction: column; }
  .sf-num {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--steel); display: flex; align-items: center; margin-bottom: 12px; gap: 8px;
  }
  .sf-icon { display: flex; align-items: center; justify-content: center; color: var(--steel); }
  .sf-body h3 { font-family: var(--font-head); font-weight: 700; font-size: 19px; margin-bottom: 10px; color: var(--navy); }
  .sf-body p { color: var(--ink-soft); font-size: 14px; margin-bottom: 16px; }

  @media (max-width: 980px) {
    .feature-grid { grid-template-columns: 1fr; }
    .service-feature { border-right: none; border-bottom: 1px solid var(--line); }
    .service-feature:last-child { border-bottom: none; }
  }
</style>
